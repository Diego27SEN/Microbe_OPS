/* Pantalla principal */
.screen {
    flex-grow: 1;
    background-color: #060b12;
    overflow: hidden;
    position: relative;
}

/* Manchas de color difuminadas (decorativas) */
.blob {
    position: absolute;
    border-radius: 400px;
    opacity: 0.6;
}

.blob-1 {
    width: 560px;
    height: 560px;
    background-color: rgba(20, 184, 166, 0.16);
    left: -160px;
    top: -190px;
}

.blob-2 {
    width: 480px;
    height: 480px;
    background-color: rgba(80, 110, 255, 0.13);
    right: -140px;
    top: 12%;
}

.blob-3 {
    width: 420px;
    height: 420px;
    background-color: rgba(251, 113, 133, 0.10);
    left: 32%;
    bottom: -220px;
}

.content {
    flex-grow: 1;
    padding: 40px 64px 30px 64px;
    justify-content: space-between;
}

/* Cabecera */
.kicker {
    color: #35d6c1;
    font-size: 13px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.title {
    color: #f4f8fb;
    font-size: 54px;
    -unity-font-style: bold;
    letter-spacing: -1px;
}

.subtitle {
    color: #93a6b8;
    font-size: 17px;
    margin-top: 6px;
    max-width: 680px;
    white-space: normal;
}

/* Zona central */
.main-row {
    flex-direction: row;
    align-items: stretch;
    margin-top: 20px;
    margin-bottom: 16px;
}

.steps {
    flex-grow: 1;
    margin-right: 34px;
    justify-content: center;
}

.step {
    flex-direction: row;
    align-items: center;
    background-color: rgba(18, 30, 43, 0.9);
    border-width: 1px;
    border-color: rgba(86, 220, 200, 0.14);
    border-radius: 18px;
    padding: 13px 18px;
    margin-bottom: 11px;
    transition-property: background-color, border-color, translate;
    transition-duration: 0.18s;
}

.step:hover {
    background-color: rgba(26, 44, 60, 0.95);
    border-color: rgba(86, 220, 200, 0.5);
    translate: 6px 0;
}

.step-badge {
    width: 42px;
    height: 42px;
    border-radius: 21px;
    background-color: #14b8a6;
    color: #04201d;
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-right: 16px;
    flex-shrink: 0;
}

.step-text {
    flex-grow: 1;
}

.step-title {
    color: #eef6fa;
    font-size: 18px;
    -unity-font-style: bold;
}

.step-desc {
    color: #8fa4b6;
    font-size: 14px;
    margin-top: 2px;
    white-space: normal;
}

/* Tarjeta de la demo */
.demo-card {
    width: 430px;
    flex-shrink: 0;
    background-color: rgba(13, 22, 32, 0.94);
    border-width: 1px;
    border-color: rgba(86, 220, 200, 0.2);
    border-radius: 24px;
    padding: 20px 22px 18px 22px;
    align-items: center;
    justify-content: space-between;
}

.demo-header {
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
    align-items: center;
}

.demo-label {
    color: #8fa4b6;
    font-size: 12px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.demo-dice {
    background-color: #14b8a6;
    color: #04201d;
    font-size: 14px;
    -unity-font-style: bold;
    padding: 6px 14px;
    border-radius: 20px;
    letter-spacing: 1px;
}

.demo-grid {
    width: 296px;
    height: 296px;
    margin: 14px 0 10px 0;
}

.demo-row {
    flex-direction: row;
    flex-grow: 1;
}

.demo-cell {
    flex-grow: 1;
    background-color: rgba(46, 70, 92, 0.5);
    border-radius: 5px;
    margin: 2px;
    transition-property: background-color, scale;
    transition-duration: 0.25s;
}

.demo-cell.demo-organism {
    background-color: #2dd4bf;
}

.demo-cell.demo-hit {
    background-color: #fb7185;
}

.demo-cell.demo-miss {
    background-color: #7dd3fc;
}

.demo-cell.demo-flash {
    background-color: #fde68a;
    scale: 1.16 1.16;
}

.demo-caption {
    color: #cbd8e3;
    font-size: 15px;
    -unity-text-align: middle-center;
    min-height: 42px;
    white-space: normal;
}

/* Pie */
.footer {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
}

.hint {
    color: #5f7488;
    font-size: 13px;
    max-width: 560px;
    white-space: normal;
}

.buttons {
    flex-direction: row;
    align-items: center;
}

.button {
    padding: 13px 26px;
    border-radius: 14px;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    border-width: 1px;
    transition-property: scale, background-color, border-color;
    transition-duration: 0.15s;
}

.button:hover {
    scale: 1.04 1.04;
}

.button:active {
    scale: 0.97 0.97;
}

.button.primary {
    background-color: #14b8a6;
    color: #04201d;
    border-color: #14b8a6;
    margin-left: 12px;
}

.button.primary:hover {
    background-color: #2dd4bf;
    border-color: #2dd4bf;
}

.button.secondary {
    background-color: rgba(22, 36, 50, 0.9);
    color: #cbd8e3;
    border-color: rgba(140, 170, 190, 0.3);
}

.button.secondary:hover {
    background-color: rgba(34, 52, 70, 0.95);
    border-color: rgba(140, 170, 190, 0.6);
}

/* Animación de entrada escalonada */
.reveal {
    opacity: 0;
    translate: 0 26px;
    transition-property: opacity, translate;
    transition-duration: 0.55s;
    transition-timing-function: ease-out;
}

.reveal.shown {
    opacity: 1;
    translate: 0 0;
}

/* Pantallas estrechas */
.narrow .content {
    padding: 26px 28px 22px 28px;
}

.narrow .title {
    font-size: 38px;
}

.narrow .subtitle {
    font-size: 15px;
}

.narrow .main-row {
    flex-direction: column;
}

.narrow .steps {
    margin-right: 0;
}

.narrow .step {
    margin-bottom: 8px;
    padding: 11px 15px;
}

.narrow .demo-card {
    width: 100%;
    margin-top: 16px;
}

.narrow .demo-grid {
    width: 220px;
    height: 220px;
}

.narrow .footer {
    flex-direction: column;
    align-items: flex-start;
}

.narrow .hint {
    margin-bottom: 12px;
}
